---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import { render } from "astro:content";
import { getAllPosts, type PostEntry } from "@/lib/posts";
import { buildEntryUrl, toDisplayDate, ymdToDisplay } from "@/lib/dates";
import { buildRelatedPostsMap } from "@/lib/related-posts";
import { normalizeTag } from "@/lib/tags";

export async function getStaticPaths() {
  const sorted = (await getAllPosts()).toSorted(
    (a, b) => +a.data.date - +b.data.date || a.id.localeCompare(b.id),
  );
  const relatedById = await buildRelatedPostsMap(sorted);

  return sorted.map((entry, index) => {
    const id = entry.id.split("/").pop()!; // e.g. 20040927p03
    const date = id.slice(0, 8);
    const part = id.slice(8); // pNN
    return {
      params: { date, part },
      props: {
        entry,
        prev: index > 0 ? sorted[index - 1] : undefined,
        next: index < sorted.length - 1 ? sorted[index + 1] : undefined,
        related: relatedById.get(entry.id) ?? [],
      },
    };
  });
}

interface Props {
  entry: PostEntry;
  prev?: PostEntry;
  next?: PostEntry;
  related: PostEntry[];
}

const { entry, prev, next, related } = Astro.props as Props;
const { Content } = await render(entry);
const dateParam = Astro.params.date!;
const displayDate = ymdToDisplay(dateParam);
const displayTitle = entry.data.title.trim() || `${displayDate} の日記`;
const tagsMetadata = JSON.stringify(entry.data.tags ?? []);
---

<BaseLayout
  title={displayTitle}
  description={entry.data.description ?? `${displayDate} の日記`}
  image={entry.data.image}
  ogType="article"
>
  <article
    class="prose prose-zinc dark:prose-invert max-w-none"
    data-pagefind-body
    data-pagefind-meta="tags[data-tags]"
    data-tags={tagsMetadata}
  >
    <header class="mb-6">
      <h1 class="mb-2 text-2xl font-semibold" data-pagefind-meta="title">
        {displayTitle}
      </h1>
      {(entry.data.tags?.length ?? 0) > 0 && (
        <div class="mb-1 flex flex-wrap gap-1">
          {entry.data.tags!.map((t) => (
            <a
              href={`/tags/${encodeURIComponent(normalizeTag(t))}`}
              class="bg-muted text-muted-foreground hover:bg-muted/80 inline-flex items-center rounded-full border px-2 py-0.5 text-xs"
              data-pagefind-filter={`tag:${normalizeTag(t)}`}
            >
              #{t}
            </a>
          ))}
        </div>
      )}
      <p class="text-muted-foreground text-xs" data-pagefind-meta="date">
        <a
          href={`/years/${entry.data.date.getFullYear()}`}
          class="hover:underline"
          aria-label={`${displayDate} の年別アーカイブ (${entry.data.date.getFullYear()}年)`}
        >
          {displayDate}
        </a>
      </p>
    </header>
    <Content />
  </article>
  <RelatedPosts posts={related} />
  <nav
    aria-label="日記の前後ナビゲーション"
    class="mt-8 flex items-center justify-between text-sm"
  >
    {next ? (
      <a
        href={buildEntryUrl(next.data.date, next.id)}
        class="bg-background hover:bg-muted inline-flex items-center rounded-md border px-2 py-1"
        title={`${toDisplayDate(next.data.date)} の新しい日記`}
      >
        ← 新しい日記 ({toDisplayDate(next.data.date)})
      </a>
    ) : (
      <span />
    )}
    {prev ? (
      <a
        href={buildEntryUrl(prev.data.date, prev.id)}
        class="bg-background hover:bg-muted inline-flex items-center rounded-md border px-2 py-1"
        title={`${toDisplayDate(prev.data.date)} の古い日記`}
      >
        古い日記 ({toDisplayDate(prev.data.date)}) →
      </a>
    ) : (
      <span />
    )}
  </nav>
</BaseLayout>
