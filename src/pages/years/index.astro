---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllPosts } from "@/lib/posts";

const all = await getAllPosts();
const counts = new Map<number, number>();
for (const p of all) {
  const y = p.data.date.getFullYear();
  counts.set(y, (counts.get(y) ?? 0) + 1);
}
const years = Array.from(counts.entries()).toSorted((a, b) => b[0] - a[0]);
const decades = new Map<number, typeof years>();
for (const entry of years) {
  const decade = Math.floor(entry[0] / 10) * 10;
  const group = decades.get(decade) ?? [];
  group.push(entry);
  decades.set(decade, group);
}
const maxCount = Math.max(0, ...counts.values());
---

<BaseLayout title="年別アーカイブ">
  <h1 class="mb-4 text-xl font-semibold">年別アーカイブ</h1>
  <p class="mb-4 text-sm text-muted-foreground">全期間 {all.length}件</p>
  {Array.from(decades.entries()).map(([decade, group]) => (
    <section class="mb-6">
      <h2 class="mb-3 text-lg font-medium">
        {decade}年代{" "}
        <span class="text-sm text-muted-foreground">
          （{group.length}年・{group.reduce((sum, [, n]) => sum + n, 0)}件）
        </span>
      </h2>
      <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
        {group.map(([y, n]) => (
          <li>
            <a href={`/years/${y}`} class="hover:underline">
              {y}年{" "}
              <span class="ml-1 text-xs text-muted-foreground">({n})</span>
            </a>
            <div class="mt-1 h-2 rounded-full bg-muted" aria-hidden="true">
              <div
                class="h-full rounded-full bg-muted-foreground"
                style={`width: ${(n / maxCount) * 100}%`}
              ></div>
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
