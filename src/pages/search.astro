---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="検索 - まちゅダイアリー" description="日記の記事を全文検索">
  <div class="mx-auto max-w-3xl">
    <h1 class="mb-6 text-2xl font-bold">記事を検索</h1>

    <form
      id="search-form"
      class="mb-6"
      action="/search"
      method="get"
      role="search"
    >
      <div class="flex gap-2">
        <label for="search-input" class="sr-only">
          検索キーワード
        </label>
        <input
          id="search-input"
          name="q"
          type="search"
          placeholder="キーワードを入力…"
          autocomplete="off"
          class="bg-background text-foreground placeholder:text-muted-foreground focus:ring-ring min-w-0 flex-1 rounded-md border px-4 py-2 text-base focus:ring-2 focus:outline-none"
        />
        <button
          type="submit"
          class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium"
        >
          <i class="fa-solid fa-magnifying-glass mr-2" aria-hidden="true"></i>
          検索
        </button>
      </div>
    </form>

    <p
      id="search-status"
      class="text-muted-foreground mb-4 text-sm"
      aria-live="polite"
    >
      キーワードを入力してください。
    </p>
    <ul id="search-results" class="space-y-4"></ul>
    <div id="search-more-wrapper" class="mt-6 hidden text-center">
      <button
        id="search-more"
        type="button"
        class="bg-background hover:bg-muted inline-flex items-center rounded-md border px-4 py-2 text-sm font-medium"
        aria-controls="search-results"
        aria-describedby="search-status"
        aria-live="polite"
      >
        もっと見る
      </button>
    </div>
  </div>

  <script>
    import { normalizeTag } from "@/lib/tags";
    import {
      loadMorePagefind,
      searchPagefind,
      type PagefindData,
    } from "@/lib/pagefind-client";

    /** 初回表示件数（「もっと見る」でこの件数ずつ追加する） */
    const PAGE_SIZE = 50;
    const input = document.querySelector<HTMLInputElement>("#search-input");
    const form = document.querySelector<HTMLFormElement>("#search-form");
    const status = document.querySelector<HTMLElement>("#search-status");
    const results = document.querySelector<HTMLUListElement>("#search-results");
    const moreWrapper = document.querySelector<HTMLElement>(
      "#search-more-wrapper",
    );
    const moreButton =
      document.querySelector<HTMLButtonElement>("#search-more");

    let searchSequence = 0;
    /** 現在の検索語（「もっと見る」の対象） */
    let currentQuery = "";
    /** 現在の検索語の総ヒット件数 */
    let totalResults = 0;
    /** 画面に表示済みの件数 */
    let shownCount = 0;

    function setMoreVisible(visible: boolean): void {
      moreWrapper?.classList.toggle("hidden", !visible);
    }

    /** 件数表示と「もっと見る」ボタンの状態を更新する */
    function updateCounts(total: number): void {
      totalResults = total;
      const remaining = Math.max(0, total - shownCount);

      if (status) {
        status.textContent =
          remaining > 0
            ? `${total}件の記事が見つかりました。${shownCount}件を表示しています。`
            : `${total}件の記事が見つかりました。`;
      }

      if (moreButton) {
        moreButton.disabled = false;
        moreButton.textContent =
          remaining > 0 ? `もっと見る（残り${remaining}件）` : "もっと見る";
        moreButton.setAttribute(
          "aria-label",
          remaining > 0
            ? `検索結果をさらに${PAGE_SIZE}件表示（残り${remaining}件）`
            : "検索結果をさらに表示",
        );
      }

      setMoreVisible(remaining > 0);
    }

    function resetResults(): void {
      shownCount = 0;
      totalResults = 0;
      setMoreVisible(false);
    }

    function queryTerms(query: string): string[] {
      return query.trim().split(/\s+/).filter(Boolean);
    }

    function appendHighlightedText(
      target: HTMLElement,
      text: string,
      terms: string[],
    ): void {
      if (terms.length === 0) {
        target.textContent = text;
        return;
      }

      const escaped = terms.map((term) =>
        term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"),
      );
      const pattern = new RegExp(`(${escaped.join("|")})`, "giu");
      for (const part of text.split(pattern)) {
        if (!part) continue;
        if (
          terms.some(
            (term) =>
              term.toLocaleLowerCase("ja") === part.toLocaleLowerCase("ja"),
          )
        ) {
          const mark = document.createElement("mark");
          mark.className = "rounded bg-yellow-200 px-0.5 dark:bg-yellow-700";
          mark.textContent = part;
          target.append(mark);
        } else {
          target.append(document.createTextNode(part));
        }
      }
    }

    function parseTags(value: string | undefined): string[] {
      if (!value) return [];
      try {
        const parsed: unknown = JSON.parse(value);
        return Array.isArray(parsed)
          ? parsed.filter((tag): tag is string => typeof tag === "string")
          : [];
      } catch {
        return [];
      }
    }

    function renderResult(data: PagefindData, terms: string[]): HTMLLIElement {
      const item = document.createElement("li");
      item.className =
        "rounded-md border bg-card p-4 transition-colors hover:bg-muted";

      const link = document.createElement("a");
      link.href = data.url;
      link.className = "block";

      const date = document.createElement("p");
      date.className = "text-sm text-muted-foreground";
      date.textContent = data.meta.date ?? "";
      link.append(date);

      const title = document.createElement("h2");
      title.className = "mt-1 text-base font-semibold";
      appendHighlightedText(title, data.meta.title ?? data.url, terms);
      link.append(title);

      const excerpt = document.createElement("p");
      excerpt.className = "mt-1 text-sm text-muted-foreground";
      appendHighlightedText(excerpt, data.plain_excerpt, terms);
      link.append(excerpt);
      item.append(link);

      const tags = parseTags(data.meta.tags);
      if (tags.length > 0) {
        const tagList = document.createElement("div");
        tagList.className = "mt-2 flex flex-wrap gap-1";
        for (const tag of tags) {
          const tagLink = document.createElement("a");
          tagLink.href = `/tags/${encodeURIComponent(normalizeTag(tag))}`;
          tagLink.className =
            "inline-flex items-center rounded-full border bg-secondary px-1.5 py-0.5 text-xs text-secondary-foreground hover:bg-secondary/80";
          tagLink.textContent = tag;
          tagList.append(tagLink);
        }
        item.append(tagList);
      }

      return item;
    }

    async function search(query: string): Promise<void> {
      if (!status || !results) return;
      const trimmed = query.trim();
      const sequence = ++searchSequence;
      currentQuery = trimmed;
      results.replaceChildren();
      resetResults();

      if (!trimmed) {
        status.textContent = "キーワードを入力してください。";
        return;
      }

      status.textContent = "検索中…";
      try {
        const response = await searchPagefind(trimmed, PAGE_SIZE, 300);
        if (!response || sequence !== searchSequence) return;

        if (response.total === 0) {
          status.textContent = `「${trimmed}」に一致する記事は見つかりませんでした。`;
          return;
        }

        const terms = queryTerms(trimmed);
        results.append(
          ...response.entries.map((entry) => renderResult(entry, terms)),
        );
        shownCount = response.entries.length;
        updateCounts(response.total);
      } catch (error) {
        console.error("Failed to load the Pagefind index", error);
        if (sequence === searchSequence) {
          status.textContent =
            "検索インデックスを読み込めませんでした。pnpm buildを実行してから開発サーバーを再起動してください。";
        }
      }
    }

    /** 「もっと見る」: 表示済みの続きを PAGE_SIZE 件追加する */
    async function loadMore(): Promise<void> {
      if (!status || !results || !moreButton || !currentQuery) return;
      const sequence = searchSequence;
      const query = currentQuery;

      moreButton.disabled = true;
      moreButton.textContent = "読み込み中…";

      try {
        const response = await loadMorePagefind(query, shownCount, PAGE_SIZE);
        // 読み込み中に検索語が変わっていたら、新しい検索の表示を優先する
        if (sequence !== searchSequence) return;

        if (!response) {
          updateCounts(totalResults);
          return;
        }

        const terms = queryTerms(query);
        results.append(
          ...response.entries.map((entry) => renderResult(entry, terms)),
        );
        shownCount += response.entries.length;
        updateCounts(response.total);
      } catch (error) {
        console.error("Failed to load more Pagefind results", error);
        if (sequence === searchSequence) {
          updateCounts(totalResults);
        }
      }
    }

    function updateUrl(query: string): void {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set("q", query);
      else url.searchParams.delete("q");
      window.history.replaceState(null, "", url);
    }

    if (input && form) {
      const initialQuery =
        new URLSearchParams(window.location.search).get("q") ?? "";
      input.value = initialQuery;
      if (initialQuery) void search(initialQuery);

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const query = input.value.trim();
        updateUrl(query);
        void search(query);
      });

      input.addEventListener("input", () => {
        const query = input.value.trim();
        updateUrl(query);
        void search(query);
      });
    }

    moreButton?.addEventListener("click", () => {
      void loadMore();
    });
  </script>
</BaseLayout>
