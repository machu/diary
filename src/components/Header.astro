---
/**
 * サイト共通ヘッダー
 * - 左: サイトタイトル（トップへ）
 * - 右: 最新 / 検索 / タグ / 年別 へのナビゲーション
 * - モバイルでは検索ボタンから検索フォームを展開
 */
import SearchSuggestions from "@/components/SearchSuggestions.astro";
---

<header class="border-border border-b bg-[#e9f4fb] dark:bg-[#0f1f2d]">
  <div class="container flex items-center justify-between py-4">
    <a href="/" class="text-lg font-bold">まちゅダイアリー</a>
    <nav class="flex items-center gap-2 text-sm sm:gap-4">
      <a href="/" class="hover:underline">最新</a>
      <SearchSuggestions
        id="header-search"
        placeholder="検索…"
        compact
        wrapperClass="hidden md:block"
      />
      <button
        id="search-toggle"
        type="button"
        class="inline-flex items-center md:hidden"
        aria-label="検索フォームを開く"
        aria-controls="mobile-search"
        aria-expanded="false"
      >
        <i class="fa-solid fa-magnifying-glass text-xs"></i>
      </button>
      <a href="/tags" class="hover:underline">タグ</a>
      <a href="/years" class="hover:underline">年別</a>
      <button
        id="theme-toggle"
        class="bg-background hover:bg-muted ml-2 inline-flex items-center rounded-md border px-2 py-1"
        aria-label="テーマ切り替え"
        title="テーマ切り替え"
      >
        <i class="fa-solid fa-moon block dark:hidden"></i>
        <i class="fa-solid fa-sun hidden dark:block"></i>
      </button>
    </nav>
  </div>

  <div id="mobile-search" class="container hidden pb-4 md:hidden">
    <SearchSuggestions id="mobile-search" placeholder="キーワードを入力…" />
  </div>

  <script>
    const root = document.documentElement;
    const key = "theme";
    const btn = document.getElementById("theme-toggle");
    function setTheme(t: "light" | "dark") {
      if (t === "dark") root.classList.add("dark");
      else root.classList.remove("dark");
      try {
        localStorage.setItem(key, t);
      } catch (_) {}
    }
    btn?.addEventListener("click", () => {
      const next = root.classList.contains("dark") ? "light" : "dark";
      setTheme(next);
    });

    const searchToggle = document.getElementById("search-toggle");
    const mobileSearch = document.getElementById("mobile-search");
    searchToggle?.addEventListener("click", () => {
      const willOpen = mobileSearch?.classList.contains("hidden") ?? false;
      mobileSearch?.classList.toggle("hidden", !willOpen);
      searchToggle.setAttribute("aria-expanded", String(willOpen));
      searchToggle.setAttribute(
        "aria-label",
        willOpen ? "検索フォームを閉じる" : "検索フォームを開く",
      );
      if (willOpen) {
        const input = mobileSearch?.querySelector<HTMLInputElement>(
          "[data-search-suggestions-input]",
        );
        input?.focus();
      }
    });
  </script>
</header>
