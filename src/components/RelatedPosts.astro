---
import type { PostEntry } from "@/lib/posts";
import { buildEntryUrl, toDisplayDate } from "@/lib/dates";

const { posts = [] } = Astro.props as { posts?: PostEntry[] };
---

<aside class="mt-10 border-t pt-6" aria-labelledby="related-posts-heading">
  <h2 id="related-posts-heading" class="mb-4 text-lg font-semibold">
    関連記事
  </h2>
  {
    posts.length > 0 ? (
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {posts.map((post) => (
          <li class="h-full">
            <a
              href={buildEntryUrl(post.data.date, post.id)}
              class="hover:bg-muted focus-visible:ring-ring bg-card block h-full rounded-md border p-3 transition-colors focus-visible:ring-2 focus-visible:outline-none"
            >
              <p class="text-muted-foreground text-xs">
                {toDisplayDate(post.data.date)}
              </p>
              <h3 class="mt-1 truncate text-sm font-medium">
                {post.data.title.trim() ||
                  `${toDisplayDate(post.data.date)} の日記`}
              </h3>
              {(post.data.tags?.length ?? 0) > 0 && (
                <div class="mt-2 flex flex-wrap gap-1">
                  {post.data.tags!.slice(0, 3).map((tag) => (
                    <span class="bg-secondary text-secondary-foreground inline-flex rounded-full border px-1.5 py-0.5 text-[10px]">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted-foreground text-sm">関連する記事はありません。</p>
    )
  }
</aside>
