{
  "name": "astro-blog",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.3 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && pagefind",
    "build:search": "pagefind",
    "preview": "astro preview",
    "lint": "eslint .",
    "astro": "astro",
    "diary": "node scripts/diary.js",
    "test": "vitest run",
    "test:output": "vitest run --config vitest.output.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:redirects": "node scripts/check-deployed-redirects.mjs",
    "verify": "pnpm test && pnpm lint && pnpm build && pnpm test:output && pnpm test:e2e && pnpm test:e2e:dev"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@iconify-json/mdi": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "strip-markdown": "^6.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vitest/coverage-v8": "^4.1.10",
    "cheerio": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "22.22.3"
  }
}
